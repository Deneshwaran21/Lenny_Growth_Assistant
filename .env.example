# ===== The Lenny Growth Assistant — environment configuration =====
# Copy to .env and fill in as needed. Safe defaults run fully local
# (Ollama + local Postgres via docker-compose) with NO cloud keys required.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database (docker-compose provides this Postgres automatically) ---
# For Supabase/Railway, replace with the connection string they give you,
# e.g. postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lenny_assistant

# --- Model provider toggle ---
# One of: anthropic | openai | ollama
LLM_PROVIDER=ollama
# Provider to use automatically if LLM_PROVIDER fails/unreachable
FALLBACK_PROVIDER=ollama

# Required only if LLM_PROVIDER=anthropic (optional otherwise)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required only if LLM_PROVIDER=openai (optional otherwise)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local model — mandatory for the graded demo. docker-compose runs an
# `ollama` service; pull a model into it once with:
#   docker compose exec ollama ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# --- RAG / knowledge base ---
TRANSCRIPTS_DIR=app/data/transcripts
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
TOP_K_CHUNKS=5
EMBEDDING_BACKEND=tfidf

LLM_TIMEOUT_SECONDS=45

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
